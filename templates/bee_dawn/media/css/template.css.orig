:root {
  --bee-base-light: #f1f5f9;
  --color-white: #fff;
  --bee-br-xs: 4px;
  --bee-br-sm: 6px;
  --bee-br-md: 8px;
  --bee-br-lg: 12px;
  --bee-br-xl: 16px;
  --bee-br-full: 100%;
  --bee-fs-xxs: 10px;
  --bee-fs-xs: 12px;
  --bee-fs-sm: 14px;
  --bee-fs-md: 16px;
  --bee-fs-lg: 18px;
  --bee-fs-xl: 24px;
  --bee-fs-xxl: 32px;
  --bee-fw-thin: 300;
  --bee-fw-normal: 400;
  --bee-fw-semibold: 500;
  --bee-fw-bold: 600;
  --bee-fw-black: 700;
  --bee-btn-sm-padding-x: .75rem;
  --bee-btn-sm-padding-y: .5rem;
  --bee-btn-padding-x: 1.5rem;
  --bee-btn-padding-y: 1rem;
  --bee-footnav-color: var(--color-white);
  --bee-footer-color: var(--color-white);
  --bee-footer-fs: var(--bee-fs-xs);
  --bee-footer-link-color: var(--color-white);
  --bee-gutter-x: 2rem;
  --bee-gutter-y: 2rem;
}

:root {
  --h1-font-size: 48px;
  --h2-font-sizs: 36px;
  --h3-font-size: 32px;
  --h4-font-size: 16px;
  --h5-font-size: 14px;
  --h6-font-size: 12px;
  --font-size-xs: 12px;
  --font-size-sm: 14px;
  --font-size-md: 16px;
  --font-size-lg: 18px;
  --font-size-xl: 24px;
  --font-size-2xl: 32px;
  --font-size-3xl: 48px;
  --font-size-4xl: 64px;
  --font-size-5xl: 96px;
  --space-2xs: 4px;
  --space-xs: 8px;
  --space-sm: 12px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 48px;
  --space-3xl: 64px;
  --space-4xl: 96px;
  --space-5xl: 128px;
  --space-x-sm: 8px;
  --space-x-md: 16px;
  --space-x-lg: 24px;
  --space-x-xl: 32px;
  /* Layout spacing */
  --space-grid: 40px;
  --space-block: 48px;
  --space-section-sm: 72px;
  --space-section: 96px;
  --space-section-lg: 128px;
  --primary: var(--bee-primary);
  --on-primary: var(--bee-on-primary);
  --secondary: var(--bee-secondary);
  --on-secondary: var(--bee-on-secondary);
  --accent: var(--bee-accent);
  --on-accent: var(--bee-on-accent);
  --color-white: #fff;
  --color-black: #000;
  --base-100: #f0f0f0;
  --base-200: #dddd;
  --base-300: #ccc;
  --link-color: var(--bee-link-color);
  --link-hover-color: var(--bee-link-hover-color);
  --link-active-color: var(--bee-link-hover-color);
  --page-bg: #f9f9f9;
  --text-heading: #222;
  --text-body: #222;
  --text-muted: #333;
  --text-disabled: #ddd;
  --border: #eee;
  --border-on-light: rgba(0,0,0,0.2);
  --border-on-dark: rgba(255, 255, 255, 0.2);
  --border-radius-xs: 4px;
  --border-radius-sm: 6px;
  --border-radius-md: 8px;
  --border-radius-lg: 12px;
  --border-radius-xl: 16px;
  --border-radius-2xl: 24px;
  --border-radius-full: 100%;
}

@media (min-width: 992px) {
  :root {
    --h1-font-size: 40px;
    --h2-font-size: 32px;
    --h3-font-size: 20px;
    --h4-font-size: 18px;
    --h5-font-size: 16px;
    --h6-font-size: 14px;
  }
}
