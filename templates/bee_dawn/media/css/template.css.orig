.table {
  --bee-table-color-type: initial;
  --bee-table-bg-type: initial;
  --bee-table-color-state: initial;
  --bee-table-bg-state: initial;
  --bee-table-color: var(--bee-body-color);
  --bee-table-bg: var(--bee-body-bg);
  --bee-table-border-color: var(--bee-border-color);
  --bee-table-accent-bg: transparent;
  --bee-table-striped-color: var(--bee-body-color);
  --bee-table-striped-bg: rgba(0, 0, 0, 0.05);
  --bee-table-active-color: var(--bee-body-color);
  --bee-table-active-bg: rgba(0, 0, 0, 0.1);
  --bee-table-hover-color: var(--bee-body-color);
  --bee-table-hover-bg: rgba(0, 0, 0, 0.075);
  width: 100%;
  margin-bottom: 1rem;
  vertical-align: top;
  border-color: var(--bee-table-border-color);
}
.table > :not(caption) > * > * {
  padding: 0.5rem 0.5rem;
  color: var(--bee-table-color-state, var(--bee-table-color-type, var(--bee-table-color)));
  background-color: var(--bee-table-bg);
  border-bottom-width: var(--bee-border-width);
  -webkit-box-shadow: inset 0 0 0 9999px var(--bee-table-bg-state, var(--bee-table-bg-type, var(--bee-table-accent-bg)));
          box-shadow: inset 0 0 0 9999px var(--bee-table-bg-state, var(--bee-table-bg-type, var(--bee-table-accent-bg)));
}
.table > tbody {
  vertical-align: inherit;
}
.table > thead {
  vertical-align: bottom;
}

.table-group-divider {
  border-top: calc(var(--bee-border-width) * 2) solid currentcolor;
}

.caption-top {
  caption-side: top;
}

.table-sm > :not(caption) > * > * {
  padding: 0.25rem 0.25rem;
}

.table-bordered > :not(caption) > * {
  border-width: var(--bee-border-width) 0;
}
.table-bordered > :not(caption) > * > * {
  border-width: 0 var(--bee-border-width);
}

.table-borderless > :not(caption) > * > * {
  border-bottom-width: 0;
}
.table-borderless > :not(:first-child) {
  border-top-width: 0;
}

.table-striped > tbody > tr:nth-of-type(odd) > * {
  --bee-table-color-type: var(--bee-table-striped-color);
  --bee-table-bg-type: var(--bee-table-striped-bg);
}

.table-striped-columns > :not(caption) > tr > :nth-child(even) {
  --bee-table-color-type: var(--bee-table-striped-color);
  --bee-table-bg-type: var(--bee-table-striped-bg);
}

.table-active {
  --bee-table-color-state: var(--bee-table-active-color);
  --bee-table-bg-state: var(--bee-table-active-bg);
}

.table-hover > tbody > tr:hover > * {
  --bee-table-color-state: var(--bee-table-hover-color);
  --bee-table-bg-state: var(--bee-table-hover-bg);
}

.table-primary {
  --bee-table-color: #000;
  --bee-table-bg: rgb(206.6, 226, 254.6);
  --bee-table-border-color: rgb(185.94, 203.4, 229.14);
  --bee-table-striped-bg: rgb(196.27, 214.7, 241.87);
  --bee-table-striped-color: #000;
  --bee-table-active-bg: rgb(185.94, 203.4, 229.14);
  --bee-table-active-color: #000;
  --bee-table-hover-bg: rgb(191.105, 209.05, 235.505);
  --bee-table-hover-color: #000;
  color: var(--bee-table-color);
  border-color: var(--bee-table-border-color);
}

