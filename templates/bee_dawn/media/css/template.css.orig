}
[role=tooltip]:not(.show)[id^=editcontact-] {
  right: auto;
  -webkit-margin-start: -10em;
          margin-inline-start: -10em;
}
[role=tooltip]:not(.show)[id^=id-skip-] {
  right: auto;
}
[role=tooltip]:not(.show)[id^=cbunpublish] {
  right: auto;
}

:focus + [role=tooltip],
:hover + [role=tooltip] {
  position: absolute;
  display: block;
}

