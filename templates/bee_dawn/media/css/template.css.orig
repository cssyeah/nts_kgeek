  border: 1px solid #6c757d;
  border-radius: var(--bee-border-radius);
  -webkit-box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.8);
          box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.8);
}
