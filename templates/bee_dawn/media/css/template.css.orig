  --bee-table-color: #fff;
  --bee-table-bg: #212529;
  --bee-table-border-color: rgb(55.2, 58.8, 62.4);
  --bee-table-striped-bg: rgb(44.1, 47.9, 51.7);
  --bee-table-striped-color: #fff;
  --bee-table-active-bg: rgb(55.2, 58.8, 62.4);
  --bee-table-active-color: #fff;
  --bee-table-hover-bg: rgb(49.65, 53.35, 57.05);
  --bee-table-hover-color: #fff;
