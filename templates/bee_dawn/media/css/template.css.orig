  position: absolute;
  left: 3px;
  top: 3px;
  height: 10px;
  width: 10px;
  -webkit-transition: 500ms all;
  transition: 500ms all;
}

.bt-preset-toggle[data-active-preset=dark] .preset-toggle-btn button {
