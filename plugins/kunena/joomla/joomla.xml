<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE extension>
<extension
    type="plugin"
    group="kunena"
    method="upgrade">
    <name>plg_kunena_joomla</name>
    <version>7.1.1</version>
    <creationDate>2026-11-10</creationDate>
    <author>Kunena Team</author>
    <authorEmail>Kunena@kunena.org</authorEmail>
    <authorUrl>https://www.kunena.org</authorUrl>
    <copyright>www.kunena.org</copyright>
    <license>GNU/GPLv3 or later</license>
    <description>PLG_KUNENA_JOOMLA_INTEGRATION_DESCRIPTION</description>
    <namespace path="src">Kunena\Forum\Plugin\Kunena\Joomla</namespace>
    <changelogurl>https://update.kunena.org/changelog/7.1.1.xml</changelogurl>
    <scriptfile>script.php</scriptfile>
    <files>
        <folder>language</folder>
        <folder plugin="joomla">src</folder>
        <folder>services</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="access"
                    type="list"
                    default="1"
                    label="PLG_KUNENA_JOOMLA_ACCESS"
                    description="PLG_KUNENA_JOOMLA_ACCESS_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="login"
                    type="list"
                    default="1"
                    label="PLG_KUNENA_JOOMLA_LOGIN"
                    description="PLG_KUNENA_JOOMLA_LOGIN_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>